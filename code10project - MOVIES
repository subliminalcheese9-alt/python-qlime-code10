balance = 30

movies = {'Action': {'Die Hard': 12, 'Terminator': 11}, 'Comedy': {'The Simpsons': 9, 'Family Guy': 10}, 'Horror': {'Get Out': 12, 'The Shining': 13}, 'Drama': {'Breaking Bad': 14, 'The Wire': 11}}

import datetime

today = datetime.date.today()

if today.weekday() == 1:

    for genre in movies:

        for movie in movies[genre]:

            movies[genre][movie] = round(movies[genre][movie] * 0.5, 2)

    print('TUESDAY DISCOUNT!')

age = (int(input('Welcome To PythonCinema! First Off, How Old Are You? We Have Discounts For Seniors And Children!').strip()))

if age < 14:

    print('Awesome! Kids Discount Applied!')

    for genre in movies:

        for movie in movies[genre]:

            movies[genre][movie] = round(movies[genre][movie] * 0.4, 2)

elif age >= 65:

    print('Awesome! Senior Discount Applied!')

    for genre in movies:

        for movie in movies[genre]:

            movies[genre][movie] = round(movies[genre][movie] * 0.3, 2)

else:

    print('No Age Discount Applied.')

while True:

    for genre in movies:

        print(f"\n{genre.upper()}:")

        for movie in movies[genre]:

            print(f"   {movie}: ${movies[genre][movie]}")

    choice = input('What Movie Would You Like To Watch Today?').strip()

    if choice == 'Die Hard':
        price = movies['Action']['Die Hard']
        if balance >= price:

            print("Here's Your Ticket To Die Hard!")

            balance = balance - price

